---
import fs from "node:fs";
import { getCollection, render } from "astro:content";
import { profile } from "../../data/config";
import "../../styles/blog.css";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const memesDir = new URL(`../../../public/blog/${post.id}/memes/`, import.meta.url);
const memeFiles = fs.existsSync(memesDir)
	? fs
			.readdirSync(memesDir)
			.filter((file) => /\.(png|jpe?g|gif|webp)$/i.test(file))
			.sort()
	: [];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{post.data.title}</title>
		<meta name="description" content={post.data.description} />
		{post.id === "train-project" && (
			<>
				<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
				<link
					rel="stylesheet"
					href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
				/>
			</>
		)}
	</head>
	<body class={post.id === "train-project" ? "blog-body post-train-project" : "blog-body"}>
		{post.id === "train-project" && (
			<>
				<canvas class="page-bg-canvas" width="960" height="640"></canvas>
				<div class="page-bg-sweep"></div>
			</>
		)}
		<article class="blog-page">
			<a class="blog-back" href="/blog/">&larr; Writing</a>
			<h1 class="blog-title">{post.data.title}</h1>
			<div class="blog-byline">
				<span>{profile.name}</span>
				<span aria-hidden="true">·</span>
				<time datetime={post.data.date.toISOString()}>{formattedDate}</time>
			</div>
			<div class="blog-content">
				<Content />
			</div>

			{memeFiles.length > 0 && (
				<section class="meme-section" aria-label="Memeable moments">
					<h2 class="meme-heading">Memeable Moments</h2>
					<div class="carousel" data-carousel>
						<div class="carousel-track">
							{memeFiles.map((file, i) => (
								<div class={`carousel-slide${i === 0 ? " is-active" : ""}`}>
									<img src={`/blog/${post.id}/memes/${file}`} alt="" loading="lazy" />
								</div>
							))}
						</div>
						{memeFiles.length > 1 && (
							<>
								<button
									type="button"
									class="carousel-arrow carousel-arrow-prev"
									aria-label="Previous meme"
									data-dir="-1"
								>
									‹
								</button>
								<button
									type="button"
									class="carousel-arrow carousel-arrow-next"
									aria-label="Next meme"
									data-dir="1"
								>
									›
								</button>
							</>
						)}
					</div>
				</section>
			)}
		</article>
	</body>
</html>

<script>
	document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
		const track = carousel.querySelector<HTMLElement>(".carousel-track");
		if (!track) return;
		const slides = Array.from(track.children) as HTMLElement[];
		if (slides.length <= 1) return;

		const prev = carousel.querySelector<HTMLButtonElement>(".carousel-arrow-prev");
		const next = carousel.querySelector<HTMLButtonElement>(".carousel-arrow-next");
		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const intervalMs = 5000;
		let index = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		function gapPx(): number {
			const style = window.getComputedStyle(track!);
			return parseFloat(style.columnGap || style.gap || "0") || 0;
		}

		function slideOffset(i: number): number {
			const gap = gapPx();
			let offset = 0;
			for (let j = 0; j < i; j++) {
				offset += slides[j].offsetWidth + gap;
			}
			return offset;
		}

		function update() {
			slides.forEach((slide, i) => slide.classList.toggle("is-active", i === index));
			const containerWidth = carousel.clientWidth;
			const activeWidth = slides[index].offsetWidth;
			const translate = slideOffset(index) - (containerWidth - activeWidth) / 2;
			if (track) track.style.transform = `translateX(-${translate}px)`;
		}

		function goTo(i: number) {
			index = (i + slides.length) % slides.length;
			update();
		}

		function stepNext() {
			goTo(index + 1);
		}

		function stepPrev() {
			goTo(index - 1);
		}

		function stop() {
			clearInterval(timer);
		}

		function start() {
			stop();
			if (prefersReducedMotion) return;
			timer = setInterval(stepNext, intervalMs);
		}

		prev?.addEventListener("click", () => {
			stepPrev();
			start();
		});
		next?.addEventListener("click", () => {
			stepNext();
			start();
		});

		carousel.addEventListener("mouseenter", stop);
		carousel.addEventListener("mouseleave", start);
		carousel.addEventListener("focusin", stop);
		carousel.addEventListener("focusout", start);
		window.addEventListener("resize", update);

		update();
		start();
	});
</script>

<script>
	(function initPageBackgroundSpectrogram() {
		const canvas = document.querySelector<HTMLCanvasElement>(".page-bg-canvas");
		if (!canvas) return;
		const ctx = canvas.getContext("2d");
		if (!ctx) return;
		const W = canvas.width;
		const H = canvas.height;
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const bands = [
			{ baseFreq: 0.88, wobbleAmp: 0.015, wobbleSpeed: 0.6, width: 76, strength: 0.75, phase: Math.random() * 6, burstSpeed: 1.1 },
			{ baseFreq: 0.74, wobbleAmp: 0.02, wobbleSpeed: 0.8, width: 44, strength: 0.45, phase: Math.random() * 6, burstSpeed: 1.6 },
			{ baseFreq: 0.42, wobbleAmp: 0.18, wobbleSpeed: 0.3, width: 17, strength: 0.28, phase: Math.random() * 6, burstSpeed: 2.1 },
			{ baseFreq: 0.22, wobbleAmp: 0.12, wobbleSpeed: 0.45, width: 15, strength: 0.24, phase: Math.random() * 6, burstSpeed: 1.4 },
		];

		function colorFor(t: number): [number, number, number, number] {
			if (t < 0.02) return [11, 15, 20, 0];
			if (t < 0.55) {
				const k = t / 0.55;
				return [11 + 26 * k, 15 + 82 * k, 20 + 96 * k, 0.28 + 0.4 * k];
			}
			const k = (t - 0.55) / 0.45;
			return [37 + 178 * k, 97 + 5 * k, 116 + 76 * k, 0.68 + 0.3 * k];
		}

		function columnAt(time: number): Float32Array {
			const col = new Float32Array(H);
			for (let y = 0; y < H; y++) {
				let intensity = 0.06;
				for (const b of bands) {
					const centerY = (b.baseFreq + b.wobbleAmp * Math.sin(time * b.wobbleSpeed + b.phase)) * H;
					const dist = y - centerY;
					const band = Math.exp(-(dist * dist) / (2 * b.width * b.width));
					const burst = 0.65 + 0.35 * Math.sin(time * b.burstSpeed + b.phase * 2);
					intensity += band * b.strength * burst;
				}
				intensity += (Math.random() - 0.5) * 0.035;
				col[y] = Math.max(0, Math.min(1, intensity));
			}
			return col;
		}

		function drawColumn(x: number, col: Float32Array) {
			const colImg = ctx!.createImageData(1, H);
			for (let y = 0; y < H; y++) {
				const [r, g, bl, a] = colorFor(col[y]);
				const idx = y * 4;
				colImg.data[idx] = r;
				colImg.data[idx + 1] = g;
				colImg.data[idx + 2] = bl;
				colImg.data[idx + 3] = a * 255;
			}
			ctx!.putImageData(colImg, x, 0);
		}

		let t = 0;
		for (let x = 0; x < W; x++) {
			t += 0.04;
			drawColumn(x, columnAt(t));
		}

		if (reduceMotion) return;

		setInterval(() => {
			const shifted = ctx!.getImageData(1, 0, W - 1, H);
			ctx!.putImageData(shifted, 0, 0);
			t += 0.04;
			drawColumn(W - 1, columnAt(t));
		}, 170);
	})();
</script>
